<% content_for :title, "Blog" %>
<section class="wrap prose">
  <h1>Blog</h1>
  <% if @posts.empty? %>
    <p>The first posts are in preparation. They are about what to ask when a technology deal reaches a family office.</p>
    <p><%= link_to "Request an introduction", new_introduction_path, class: "btn" %></p>
  <% end %>
  <% @posts.each do |post| %>
    <article class="post-card">
      <h3><%= link_to post.title, post_path(post) %></h3>
      <p class="muted"><%= post.published_at.strftime("%B %-d, %Y") %></p>
      <p><%= post.summary %></p>
    </article>
  <% end %>
</section>
