<% content_for :title, @post.title %>
<% content_for :description, truncate(@post.summary.to_s, length: 150) if @post.summary.present? %>
<% content_for :og_image, @post.image_url if @post.image_url.present? %>
<% content_for :og_type, "article" %>
<div class="post-hero"><div class="wrap">
  <p class="crumbs"><%= link_to "Home", root_path %> / <%= link_to "Blog", posts_path %></p>
  <% if @post.tags.to_a.any? %><ul class="chips"><% @post.tags.each do |t| %><li><%= link_to t, posts_path(tag: t), class: "chip" %></li><% end %></ul><% end %>
  <h1><%= @post.title %></h1>
  <p class="muted"><%= @post.published_at.strftime("%B %-d, %Y") %> · <%= @post.author.presence || "Troy M. Pearsall" %> · <%= reading_minutes(@post.body) %> min read</p>
</div></div>
<% if @post.image_url.present? %><div class="post-cover"><img src="<%= @post.image_url %>" alt=""></div><% end %>
<article class="post-body">
  <%= @post.body.include?("<p>") ? sanitize(@post.body, tags: %w[p ol ul li strong em a sup sub img figure table thead tbody tr th td h2 h3 blockquote br], attributes: %w[href src alt class id]) : simple_format(@post.body) %>
  <div class="cta-band">
    <h3>Have a deal where the technology is the open question?</h3>
    <%= link_to "Request an introduction", new_introduction_path, class: "btn" %>
  </div>
  <p><%= link_to "← All posts", posts_path %></p>
</article>
