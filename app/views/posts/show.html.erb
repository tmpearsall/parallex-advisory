<% content_for :title, @post.title %>
<article class="wrap prose">
  <h1><%= @post.title %></h1>
  <p class="muted"><%= @post.published_at.strftime("%B %-d, %Y") %> · Troy M. Pearsall</p>
  <% if @post.image_url.present? %><figure class="post-image"><img src="<%= @post.image_url %>" alt=""></figure><% end %>
  <%= @post.body.include?("<p>") ? sanitize(@post.body, tags: %w[p ol ul li strong em a sup sub img figure table thead tbody tr th td h2 h3 blockquote br], attributes: %w[href src alt class id]) : simple_format(@post.body) %>
  <p><%= link_to "Request an introduction", new_introduction_path, class: "btn" %></p>
  <p><%= link_to "All posts", posts_path %></p>
</article>
