<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= content_for?(:title) ? "#{yield(:title)} · Parallex" : "Parallex — Technical leadership for investors" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <% site_desc = "Technical diligence and fractional CTO leadership for family offices and the businesses they back." %>
  <meta name="description" content="<%= content_for?(:description) ? content_for(:description) : site_desc %>">
  <%# Link previews (LinkedIn, Facebook, X): a post sets its own image with content_for :og_image; every other page uses the logo. %>
  <% og_title = content_for?(:title) ? "#{content_for(:title)} · Parallex" : "Parallex — Technical leadership for investors" %>
  <% og_desc = content_for?(:description) ? content_for(:description) : site_desc %>
  <% og_image = content_for?(:og_image) ? content_for(:og_image).to_s : "#{request.base_url}/logo-200.jpg" %>
  <% og_image = request.base_url + og_image if og_image.start_with?("/") %>
  <meta property="og:site_name" content="Parallex">
  <meta property="og:type" content="<%= content_for?(:og_type) ? content_for(:og_type) : 'website' %>">
  <meta property="og:title" content="<%= og_title %>">
  <meta property="og:description" content="<%= og_desc %>">
  <meta property="og:url" content="<%= request.base_url + request.path %>">
  <meta property="og:image" content="<%= og_image %>">
  <meta name="twitter:card" content="<%= content_for?(:og_image) ? 'summary_large_image' : 'summary' %>">
  <meta name="twitter:title" content="<%= og_title %>">
  <meta name="twitter:description" content="<%= og_desc %>">
  <meta name="twitter:image" content="<%= og_image %>">
  <link rel="icon" href="/logo-200.jpg">
  <link rel="apple-touch-icon" href="/logo-200.jpg">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "site", "data-turbo-track": "reload" %>
</head>
<body>
  <header class="top">
    <div class="wrap bar">
      <a class="brand" href="<%= root_path %>"><img class="mark" src="/logo-200.jpg" alt="Parallex" width="56" height="56"></a>
      <nav>
        <%= link_to "How I work", how_path %>
        <%= link_to "About", about_path %>
        <%= link_to "Blog", posts_path %>
        <%= link_to "Request an introduction", new_introduction_path, class: "btn small" %>
      </nav>
    </div>
  </header>
  <main><%= yield %></main>
  <footer class="foot">
    <div class="wrap">
      <div class="grid">
        <div>
          <h4>Parallex</h4>
          <p>Technical due diligence and advisory for family offices. Every engagement has a written scope and fee. Every expert signs a non-disclosure agreement.</p>
        </div>
        <div>
          <h4>Explore</h4>
          <ul>
            <li><%= link_to "How I work", how_path %></li>
            <li><%= link_to "About", about_path %></li>
            <li><%= link_to "Blog", posts_path %></li>
            <li><%= link_to "Privacy", privacy_path %></li>
            <li><%= link_to "Terms of use", terms_path %></li>
          </ul>
        </div>
        <div>
          <h4>Talk to us</h4>
          <p>Tell us what is on the table. We reply to every introduction.</p>
          <p><%= link_to "Request an introduction", new_introduction_path, class: "btn small" %></p>
        </div>
        <div>
          <h4>Our other sites</h4>
          <ul>
            <li><a href="https://www.parallexprints.com/">Parallex Prints: small-batch 3D-printed coasters, gifts and merch</a></li>
            <li><a href="https://osparna.com/">Osparna: decision intelligence for investors</a></li>
            <li><a href="https://www.oluwadi.com/">Oluwadi: investigating the overlooked</a></li>
            <li><a href="https://doayni.com/">DoAyni: sacred exchange, made visible</a></li>
          </ul>
        </div>
      </div>
      <div class="fine"><span>© <%= Date.current.year %> Parallex LLC, a Virginia limited liability company</span><span>A company since 2009</span></div>
    </div>
  </footer>
</body>
</html>
